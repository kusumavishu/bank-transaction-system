<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>User Register</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #667eea, #764ba2);
    }

    .card {
      background: #fff;
      padding: 35px 30px;
      border-radius: 12px;
      width: 380px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      animation: fadeIn 0.4s ease-in-out;
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #333;
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      font-size: 14px;
      color: #555;
      margin-bottom: 5px;
      display: block;
    }

    input {
      width: 100%;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      transition: 0.2s;
    }

    input:focus {
      border-color: #667eea;
      outline: none;
      box-shadow: 0 0 5px rgba(102, 126, 234, 0.4);
    }

    .error-text {
      color: #e74c3c;
      font-size: 12px;
      margin-top: 4px;
    }

    .success-text {
      color: #2ecc71;
      font-size: 13px;
      margin-bottom: 10px;
      text-align: center;
    }

    button {
      width: 100%;
      padding: 12px;
      background: #667eea;
      border: none;
      border-radius: 6px;
      color: white;
      font-size: 16px;
      cursor: pointer;
      transition: 0.3s;
    }

    button:hover {
      background: #5a67d8;
    }

    button:disabled {
      background: #999;
      cursor: not-allowed;
    }

    .footer {
      margin-top: 12px;
      text-align: center;
      font-size: 13px;
    }

    .footer a {
      color: #667eea;
      text-decoration: none;
      font-weight: 500;
    }

    .footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>

  <div class="card">
    <h2>Create Account 🚀</h2>

    <div id="successMessage" class="success-text"></div>

    <form id="registerForm">

      <!-- Name -->
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" placeholder="Enter your name" />
        <div id="nameError" class="error-text"></div>
      </div>

      <!-- Email -->
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" placeholder="Enter your email" />
        <div id="emailError" class="error-text"></div>
      </div>

      <!-- Password -->
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Enter your password" />
        <div id="passwordError" class="error-text"></div>
      </div>

      <!-- Confirm Password -->
      <div class="form-group">
        <label>Confirm Password</label>
        <input type="password" name="confirmPassword" placeholder="Confirm password" />
        <div id="confirmPasswordError" class="error-text"></div>
      </div>

      <button type="submit" id="submitBtn">Register</button>
    </form>

    <div class="footer">
      Already have an account? <a href="/">Login</a>
    </div>
  </div>

  <!-- 🔥 JS (Formik-like behavior) -->
  <script>
    const form = document.getElementById("registerForm");
    const btn = document.getElementById("submitBtn");
    const successBox = document.getElementById("successMessage");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      btn.disabled = true;
      btn.innerText = "Registering...";

      const formData = new FormData(form);

      const data = {
        name: formData.get("name"),
        email: formData.get("email"),
        password: formData.get("password"),
        confirmPassword: formData.get("confirmPassword"),
      };

      // clear old errors
      document.querySelectorAll(".error-text").forEach(el => el.innerText = "");
      successBox.innerText = "";

      try {
        const res = await fetch("/api/user/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        const result = await res.json();




        if (!result.success) {
          // 🔴 show field errors
          for (let key in result.errors) {
            const el = document.getElementById(key + "Error");
            if (el) el.innerText = result.errors[key];
          }
        } else {
          // 🟢 success
          successBox.innerText = result.message;
          form.reset();
        }

      } catch (err) {
        console.log(err);
      } finally {
        btn.disabled = false;
        btn.innerText = "Register";
      }
    });
  </script>

</body>
</html>